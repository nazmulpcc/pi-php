{
  "name": "nazmulpcc/pi-ai",
  "description": "Provider-agnostic LLM layer for the Pi PHP runtime",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.3",
    "react/promise": "^3.0",
    "react/event-loop": "^1.5",
    "react/http": "^1.11",
    "react/socket": "^1.15",
    "ratchet/pawl": "^0.4",
    "psr/http-message": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Pi\\AI\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pi\\AI\\Tests\\": "tests/"
    }
  }
}
