{
  "name": "nazmulpcc/pi-php",
  "description": "Pi agent implementation in PHP",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.3",
    "react/promise": "^3.0",
    "react/event-loop": "^1.5",
    "react/http": "^1.11",
    "react/socket": "^1.15",
    "ratchet/pawl": "^0.4",
    "psr/http-message": "^1.1",
    "symfony/console": "^7.4",
    "react/child-process": "^0.6.7"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "laravel/pint": "^1.29"
  },
  "autoload": {
    "psr-4": {
      "Pi\\Agent\\": "packages/agent/src/",
      "Pi\\AI\\": "packages/ai/src/",
      "Pi\\CodingAgent\\": "packages/coding-agent/src/",
      "Pi\\Console\\": "packages/console/src/"
    },
    "files": [
      "packages/ai/src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pi\\Agent\\Tests\\": "packages/agent/tests/",
      "Pi\\AI\\Tests\\": "packages/ai/tests/",
      "Pi\\CodingAgent\\Tests\\": "packages/coding-agent/tests/",
      "Pi\\Console\\Tests\\": "packages/console/tests/"
    },
    "files": [
    ]
  },
  "extra": {
    "pi": {
      "extensions": []
    }
  },
  "scripts": {
    "lint": "vendor/bin/pint packages/agent/src packages/agent/tests packages/ai/src packages/ai/tests packages/coding-agent/src packages/coding-agent/tests packages/console/src packages/console/tests packages/extension-plan",
    "lint:check": "vendor/bin/pint --test packages/agent/src packages/agent/tests packages/ai/src packages/ai/tests packages/coding-agent/src packages/coding-agent/tests packages/console/src packages/console/tests packages/extension-plan",
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "@lint",
      "vendor/bin/pest packages/agent/tests packages/ai/tests packages/coding-agent/tests packages/console/tests"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "process-timeout": 0
  }
}
